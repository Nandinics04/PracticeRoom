# Copy to .env and fill in before: docker compose up --build
# For Fly production, set the same values via: flyctl secrets set -a hirepro-nandini ...
# Live URL: https://hirepro-nandini.fly.dev/  — see docs/deploy.md

# Groq (or OpenAI-compatible) — required for prepare + live interviewer
PRACTICE_ROOM_LLM_KEY=gsk_your_key_here
PRACTICE_ROOM_LLM_BASE=https://api.groq.com/openai/v1
PRACTICE_ROOM_LLM_MODEL=llama-3.3-70b-versatile

# Optional alias if you keep a separate Groq key name
# PRACTICE_ROOM_GROQ_KEY=

# Browser origins allowed for cookie auth (comma-separated)
# Local Docker: localhost:8080 | Vite dev: localhost:5173 | Prod: https://hirepro-nandini.fly.dev
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Host port for the local docker-compose web UI (nginx)
WEB_PORT=8080
